# ---------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Infrastructure
# MONGO_URI=mongodb://mongodb:27017/otdms
# REDIS_URL=redis://redis:6379
MONGO_URI=mongodb://127.0.0.1:27017/otdms
REDIS_URL=redis://127.0.0.1:6379

# Auth secrets - CHANGE THESE. Generate: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CLIENT_ORIGIN=http://localhost:5173

# SMTP - real delivery of the login OTP email. Leave SMTP_HOST blank to fall
# back to the mock mailer (logged, not delivered - fine for local dev/tests).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OTDMS <no-reply@otdms.local>

# TEMPORARY local-testing only: when set, every OTP is this fixed 6-digit code
# and no email is sent at all. Leave blank once real SMTP delivery works.
OTP_STATIC_CODE=

# Cloudinary - proof/receipt files are uploaded here instead of local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=otdms/proofs

# File upload
PROOF_MAX_FILE_SIZE_MB=5

# Seeding
SEED_DEFAULT_PASSWORD=Demo@12345
LOG_LEVEL=debug

