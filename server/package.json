{
  "name": "otdms-server",
  "version": "1.0.0",
  "private": true,
  "description": "Operational Task & Disbursement Management System - API (educational simulation)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:ci": "npm ci --include=dev && npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:unit": "jest src/tests/unit --runInBand",
    "test:integration": "jest src/tests/integration --runInBand",
    "seed": "tsx src/seed/seed.ts",
    "audit": "tsx src/audit/run-audit.ts",
    "audit:dmc": "tsx src/audit/dmc/run.ts",
    "audit:dmc:adversarial": "tsx src/audit/dmc/adversarial.ts",
    "audit:dmc:mutations": "tsx src/audit/dmc/mutation-probe.ts",
    "audit:dmc:rounding": "tsx src/audit/dmc/probe-rounding.ts",
    "check:commission": "tsx src/audit/_check-commission.ts",
    "check:capacity": "tsx src/audit/_check-capacity.ts",
    "check:ledger": "tsx src/audit/_check-ledger.ts"
  },
  "dependencies": {
    "@types/cookie": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^10.10.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  }
}
